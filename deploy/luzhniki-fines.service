[Unit]
Description=Luzhniki fines payment service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/luzhniki-oplata-shtrafov/shtrafiParkovrf
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/opt/luzhniki-oplata-shtrafov/shtrafiParkovrf/.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
